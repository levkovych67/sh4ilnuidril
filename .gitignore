# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Local-only folders (keep out of git)
.superpowers/
source-assets/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
docs
# next.js
/.next/
/out/

# production
/build
screenshots
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE + scratch (added when committing project baseline)
.idea/
.tmp_page.html
